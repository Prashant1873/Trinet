# Google API Key for Google Places Text Search & Gemini AI
GOOGLE_API_KEY=your_google_api_key_here

# Apify API Token for Web Scraping / Google Maps Actor
APIFY_API_TOKEN=your_apify_api_token_here

# Redis URL for BullMQ (optional - falls back to in-process queue)
REDIS_URL=redis://localhost:6379

# Database
DATABASE_URL=file:./dev.db
